# Kobo Deal Notifier (TS) — bootstrap configuration
# Copy to `.env` and adjust. Values seed the DB-backed settings table on first
# boot; afterwards everything is editable from the web UI.
# `docker compose` injects this file into the backend container automatically.

# ---- Runtime ----
# Where kobo.db + tokens.json + summary-*.html live (mounted volume).
DATA_DIR=/app/data

# ---- Deal rules (OR logic: notify if a book matches EITHER rule) ----
# Rule A: WasPrice > Price (strikethrough sale), only if the drop is at least
#         MIN_DISCOUNT_PERCENT percent. 0 = any drop.
# Rule B: current Price < PRICE_THRESHOLD_EUR.
PRICE_THRESHOLD_EUR=5.00
MIN_DISCOUNT_PERCENT=0

# ---- Scheduling ----
# Daily run time (24h HH:MM) in the container's local timezone.
CHECK_TIME=10:00
TZ=Europe/Brussels

# ---- Behaviour ----
# DRY_RUN=true: build the summary HTML and write it to DATA_DIR, send nothing.
DRY_RUN=false

# ---- SMTP (used only to SEND the daily summary email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=
EMAIL_TO=

# ---- Kobo pairing identity (reported once to Kobo's activation API) ----
KOBO_DEVICE_PLATFORM_ID=KoboTouch
KOBO_AFFILIATE=kobo
KOBO_APP_VERSION=4.52.0